      "parameters": {
        "promptType": "define",
        "text": "=You are a strict message classification robot.\n\nYour task is to classify the following customer message into exactly one of these categories:\nBilling\nSupport\nSales\nSpam\n\nClassification rules:\n- Billing: payments, refunds, invoices, charges, subscriptions, card/payment failures\n- Support: bugs, errors, login issues, password reset, technical help, account problems\n- Sales: pricing, plans, features, demos, buying intent, upgrades, business inquiries\n- Spam: irrelevant, promotional, scam-like, phishing, nonsense, or messages unrelated to the company/services\n\nRules:\n- Output only one word\n- The output must be exactly one of these:\nBilling\nSupport\nSales\nSpam\n- Do not explain\n- Do not add punctuation\n- Do not add extra text\n- Do not say \"The category is...\"\n\nCustomer message:\n{{ $json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a strict classification agent. Output ONLY valid JSON.\nNo markdown. No extra text."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
